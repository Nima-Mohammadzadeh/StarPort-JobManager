# Job Manager configuration
# Leave a path blank to keep it next to app.py (home / testing).
# If a path is set and can't be reached at startup, the app refuses to start
# instead of quietly using a different database or serial registry.

[paths]
# Shop floor examples:
#   database        = Z:\3 Encoding and Printing Files\Operations\local.db
#   serial_registry = Z:\3 Encoding and Printing Files\Operations\serial_registry
#   z_drive_base    = Z:\3 Encoding and Printing Files\Customers Encoding Files
database        =
serial_registry =
z_drive_base    =

[server]
host = 0.0.0.0
port = 5050

[proofs]
# New jobs with a UPC find their approved proof in this workbook (sheet "Proof Registry", column
# "UPC / Item Number"), copy the PDF into the job's Proof folder and print it on THIS PC's default printer.
# If the workbook can't be reached, jobs are made as usual with no proof.
registry      = Z:\Proofs\_Proof_Registry\Proof_Registry.xlsx
auto_print    = 1
# Blank = the PDF app's own Print command. For no flash of a viewer window, install SumatraPDF and use:
# print_command = "C:\Program Files\SumatraPDF\SumatraPDF.exe" -print-to-default -silent "{file}"
print_command =
