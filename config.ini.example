# Job Manager configuration
# Leave a path blank to keep it next to app.py (home / testing).
# If a path is set and can't be reached at startup, the app refuses to start
# instead of quietly using a different database or serial registry.

[paths]
# Shop floor examples:
#   database        = Z:\3 Encoding and Printing Files\Operations\local.db
#   serial_registry = Z:\3 Encoding and Printing Files\Operations\serial_registry
#   z_drive_base    = Z:\3 Encoding and Printing Files\Customers Encoding Files
database        =
serial_registry =
z_drive_base    =

[proofing]
# RFID proofing records (saved proofs, proofing settings, inlay library, history).
# Blank = a proofing_data folder next to app.py. A folder on the share is better:
#   data_dir = Z:\3 Encoding and Printing Files\Operations\proofing_data
# Generated proof PDFs for a job are written into that job's Proof folder.
data_dir =

[server]
host = 0.0.0.0
port = 5050
